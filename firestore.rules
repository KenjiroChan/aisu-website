rules_version = '2';

// AISU Café & Parfaiteria: who can read and write what in the database.
// Paste this whole file into Firebase console → Firestore Database → Rules, then press Publish.
//
// - Customers (no sign-in) can only ADD a booking or a pickup order, in the right shape.
//   They can see which half hours are full, but never anyone's name or phone number.
// - Signed-in staff (listed in /staff, or the owner) can read bookings and orders and change their status.
// - Only the owner account can manage the staff list and delete records.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is who ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && myEmail() == 'aisuparfaiteria@gmail.com';
    }
    function isStaff() {
      return signedIn()
        && (isOwner() || exists(/databases/$(database)/documents/staff/$(myEmail())));
    }

    // ---------- small helpers ----------
    function text(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function isDay(v) {
      return v is string && v.matches('^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$');
    }
    function settingsPath() {
      return /databases/$(database)/documents/settings/main;
    }
    // Default capacity (20 guests per half hour) must match DEFAULTS in assets/backend.js.
    function withinCapacity(n) {
      return (!exists(settingsPath()) && n <= 20)
        || (exists(settingsPath()) && n <= get(settingsPath()).data.capacity);
    }
    function ordersOpen() {
      return !exists(settingsPath())
        || get(settingsPath()).data.get('ordersPaused', false) == false;
    }
    function onlyStatusChanged(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt', 'statusBy'])
        && request.resource.data.status in allowed;
    }

    // ---------- bookings ----------
    function validReservation(r) {
      return r.keys().hasAll(['ref', 'date', 'time', 'guests', 'occasion', 'seat', 'name', 'phone', 'email', 'notes', 'lang', 'status', 'createdAt'])
        && r.keys().hasOnly(['ref', 'date', 'time', 'guests', 'occasion', 'seat', 'name', 'phone', 'email', 'notes', 'lang', 'status', 'createdAt'])
        && text(r.ref, 9, 9)
        && isDay(r.date)
        && r.time is int && r.time >= 0 && r.time < 1440 && r.time % 30 == 0
        && r.guests is int && r.guests >= 1 && r.guests <= 8
        && r.occasion in ['cafe', 'brunch', 'peppa', 'classique', 'gourmand']
        && r.seat in ['table', 'booth', 'outside', 'any']
        && text(r.name, 1, 80)
        && text(r.phone, 6, 30)
        && text(r.email, 0, 120)
        && text(r.notes, 0, 500)
        && r.lang in ['fr', 'en', 'mg']
        && r.status == 'new'
        && r.createdAt == request.time;
    }
    // A booking must be saved together with its half hour's guest count, and that count must stay
    // within capacity. Both writes happen in one transaction from the website.
    function slotCountedFor(id, r) {
      let path = /databases/$(database)/documents/slots/$(r.date);
      let key = string(r.time);
      let after = getAfter(path).data;
      return after.last == id
        && withinCapacity(after.g.get(key, 0))
        && ((!exists(path) && after.g.get(key, 0) == r.guests)
          || (exists(path) && after.g.get(key, 0) == get(path).data.g.get(key, 0) + r.guests));
    }

    match /reservations/{id} {
      allow create: if validReservation(request.resource.data) && slotCountedFor(id, request.resource.data);
      allow read: if isStaff();
      allow update: if isStaff() && onlyStatusChanged(['new', 'confirmed', 'seated', 'noshow', 'cancelled']);
      allow delete: if isOwner();
    }

    // ---------- guest counts per half hour (no names) ----------
    // A public write may only add one new booking's guests to that booking's half hour.
    function slotCreateOk(day) {
      let nd = request.resource.data;
      let rpath = /databases/$(database)/documents/reservations/$(nd.last);
      let r = getAfter(rpath).data;
      return nd.keys().hasOnly(['g', 'last'])
        && !exists(rpath)
        && r.date == day
        && nd.g.keys().hasOnly([string(r.time)])
        && nd.g.get(string(r.time), 0) == r.guests;
    }
    function slotUpdateOk(day) {
      let nd = request.resource.data;
      let rpath = /databases/$(database)/documents/reservations/$(nd.last);
      let r = getAfter(rpath).data;
      let key = string(r.time);
      return nd.keys().hasOnly(['g', 'last'])
        && !exists(rpath)
        && r.date == day
        && nd.g.diff(resource.data.g).affectedKeys().hasOnly([key])
        && nd.g.get(key, 0) == resource.data.g.get(key, 0) + r.guests;
    }

    match /slots/{day} {
      allow read: if true;
      allow create: if isStaff() || slotCreateOk(day);
      allow update: if isStaff() || slotUpdateOk(day);
      allow delete: if isStaff();
    }

    // ---------- pickup orders ----------
    function validOrder(o) {
      return o.keys().hasAll(['ref', 'items', 'pickupDay', 'pickupTime', 'name', 'phone', 'notes', 'lang', 'status', 'createdAt'])
        && o.keys().hasOnly(['ref', 'items', 'pickupDay', 'pickupTime', 'name', 'phone', 'notes', 'lang', 'status', 'createdAt'])
        && text(o.ref, 9, 9)
        && o.items is list && o.items.size() >= 1 && o.items.size() <= 30
        && isDay(o.pickupDay)
        && o.pickupTime is int && o.pickupTime >= 0 && o.pickupTime < 1440 && o.pickupTime % 15 == 0
        && text(o.name, 1, 80)
        && text(o.phone, 6, 30)
        && text(o.notes, 0, 500)
        && o.lang in ['fr', 'en', 'mg']
        && o.status == 'new'
        && o.createdAt == request.time;
    }

    match /orders/{id} {
      allow create: if ordersOpen() && validOrder(request.resource.data);
      allow read: if isStaff();
      allow update: if isStaff() && onlyStatusChanged(['new', 'preparing', 'ready', 'collected', 'cancelled']);
      allow delete: if isOwner();
    }

    // ---------- café settings (capacity, pause online orders) ----------
    match /settings/{name} {
      allow read: if true;
      allow write: if isStaff() && name == 'main'
        && request.resource.data.keys().hasOnly(['capacity', 'ordersPaused', 'updatedAt', 'updatedBy'])
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 1 && request.resource.data.capacity <= 200
        && request.resource.data.ordersPaused is bool;
    }

    // ---------- staff list (document id = the staff member's email, lower case) ----------
    match /staff/{email} {
      allow read: if isStaff();
      allow create, update: if isOwner() && email == email.lower()
        && request.resource.data.keys().hasOnly(['addedAt', 'addedBy', 'name']);
      allow delete: if isOwner();
    }
  }
}

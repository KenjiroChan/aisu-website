rules_version = '2';

// AISU Café & Parfaiteria: who can read and write what in the database.
// Paste this whole file into Firebase console → Firestore Database → Rules, then press Publish.
//
// - Customers (no sign-in) can only ADD a booking or a pickup order, in the right shape, and only
//   while the café accepts them (not paused, not a closed date, half hour not full).
//   They can see which half hours are full and the café settings, never anyone's name or phone.
// - Signed-in staff (listed in /staff, or the owner) read bookings and orders, change their status,
//   add bookings taken by phone or walk-ins, edit a booking (time, guests, table, note, contact), and change settings.
// - Only the owner account manages the staff list and deletes records.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is who ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && myEmail() == 'aisuparfaiteria@gmail.com';
    }
    function isStaff() {
      return signedIn()
        && (isOwner() || exists(/databases/$(database)/documents/staff/$(myEmail())));
    }

    // ---------- small helpers ----------
    function text(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function isDay(v) {
      return v is string && v.matches('^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$');
    }
    function settingsPath() {
      return /databases/$(database)/documents/settings/main;
    }
    // Defaults (20 guests per half hour, nothing paused, no closed dates) match DEFAULTS in assets/backend.js.
    function setting(name, fallback) {
      return exists(settingsPath()) ? get(settingsPath()).data.get(name, fallback) : fallback;
    }
    function withinCapacity(n) {
      return n <= setting('capacity', 20);
    }
    function bookingsOpen(day) {
      return setting('bookingsPaused', false) == false && !(day in setting('closedDays', []));
    }
    function ordersOpen(day) {
      return setting('ordersPaused', false) == false && !(day in setting('closedDays', []));
    }

    // ---------- bookings ----------
    function bookingShape(r) {
      return text(r.ref, 9, 9)
        && isDay(r.date)
        && r.time is int && r.time >= 0 && r.time < 1440 && r.time % 30 == 0
        && r.occasion in ['cafe', 'brunch', 'peppa', 'classique', 'gourmand']
        && r.seat in ['table', 'booth', 'outside', 'any']
        && text(r.name, 1, 80)
        && text(r.phone, 0, 30)
        && text(r.email, 0, 120)
        && text(r.notes, 0, 500)
        && r.lang in ['fr', 'en', 'mg']
        && r.createdAt == request.time;
    }
    function validPublicReservation(r) {
      return r.keys().hasAll(['ref', 'date', 'time', 'guests', 'occasion', 'seat', 'name', 'phone', 'email', 'notes', 'lang', 'status', 'createdAt'])
        && r.keys().hasOnly(['ref', 'date', 'time', 'guests', 'occasion', 'seat', 'name', 'phone', 'email', 'notes', 'lang', 'status', 'createdAt'])
        && bookingShape(r)
        && text(r.phone, 6, 30)
        && r.guests is int && r.guests >= 1 && r.guests <= 8
        && r.status == 'new';
    }
    // Bookings staff take by phone or for walk-ins: bigger parties allowed, can start confirmed or seated.
    function validStaffReservation(r) {
      return r.keys().hasAll(['ref', 'date', 'time', 'guests', 'occasion', 'seat', 'name', 'phone', 'email', 'notes', 'lang', 'status', 'createdAt'])
        && r.keys().hasOnly(['ref', 'date', 'time', 'guests', 'occasion', 'seat', 'name', 'phone', 'email', 'notes', 'lang', 'status', 'createdAt', 'source', 'table', 'staffNote', 'statusBy'])
        && bookingShape(r)
        && r.guests is int && r.guests >= 1 && r.guests <= 40
        && r.status in ['new', 'confirmed', 'seated']
        && r.get('source', 'staff') == 'staff'
        && text(r.get('table', ''), 0, 20)
        && text(r.get('staffNote', ''), 0, 300);
    }
    // A public booking must be saved together with its half hour's guest count, and that count must stay
    // within capacity. Both writes happen in one transaction from the website.
    function slotCountedFor(id, r) {
      let path = /databases/$(database)/documents/slots/$(r.date);
      let key = string(r.time);
      let after = getAfter(path).data;
      return after.last == id
        && withinCapacity(after.g.get(key, 0))
        && ((!exists(path) && after.g.get(key, 0) == r.guests)
          || (exists(path) && after.g.get(key, 0) == get(path).data.g.get(key, 0) + r.guests));
    }
    function validStaffEdit() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt', 'statusBy', 'table', 'staffNote', 'date', 'time', 'guests', 'name', 'phone', 'occasion', 'seat'])
        && d.status in ['new', 'confirmed', 'seated', 'noshow', 'cancelled']
        && text(d.name, 1, 80) && text(d.phone, 0, 30)
        && d.occasion in ['cafe', 'brunch', 'peppa', 'classique', 'gourmand']
        && d.seat in ['table', 'booth', 'outside', 'any']
        && isDay(d.date)
        && d.time is int && d.time >= 0 && d.time < 1440 && d.time % 30 == 0
        && d.guests is int && d.guests >= 1 && d.guests <= 40
        && text(d.get('table', ''), 0, 20)
        && text(d.get('staffNote', ''), 0, 300);
    }

    match /reservations/{id} {
      allow create: if (validPublicReservation(request.resource.data)
                        && bookingsOpen(request.resource.data.date)
                        && slotCountedFor(id, request.resource.data))
                    || (isStaff() && validStaffReservation(request.resource.data));
      allow read: if isStaff();
      allow update: if isStaff() && validStaffEdit();
      allow delete: if isOwner();
    }

    // ---------- guest counts per half hour (no names) ----------
    // A public write may only add one new booking's guests to that booking's half hour.
    function slotCreateOk(day) {
      let nd = request.resource.data;
      let rpath = /databases/$(database)/documents/reservations/$(nd.last);
      let r = getAfter(rpath).data;
      return nd.keys().hasOnly(['g', 'last'])
        && !exists(rpath)
        && r.date == day
        && nd.g.keys().hasOnly([string(r.time)])
        && nd.g.get(string(r.time), 0) == r.guests;
    }
    function slotUpdateOk(day) {
      let nd = request.resource.data;
      let rpath = /databases/$(database)/documents/reservations/$(nd.last);
      let r = getAfter(rpath).data;
      let key = string(r.time);
      return nd.keys().hasOnly(['g', 'last'])
        && !exists(rpath)
        && r.date == day
        && nd.g.diff(resource.data.g).affectedKeys().hasOnly([key])
        && nd.g.get(key, 0) == resource.data.g.get(key, 0) + r.guests;
    }

    match /slots/{day} {
      allow read: if true;
      allow create: if isStaff() || slotCreateOk(day);
      allow update: if isStaff() || slotUpdateOk(day);
      allow delete: if isStaff();
    }

    // ---------- pickup orders ----------
    function validOrder(o) {
      return o.keys().hasAll(['ref', 'items', 'pickupDay', 'pickupTime', 'name', 'phone', 'notes', 'lang', 'status', 'createdAt'])
        && o.keys().hasOnly(['ref', 'items', 'pickupDay', 'pickupTime', 'name', 'phone', 'notes', 'lang', 'status', 'createdAt'])
        && text(o.ref, 9, 9)
        && o.items is list && o.items.size() >= 1 && o.items.size() <= 30
        && isDay(o.pickupDay)
        && o.pickupTime is int && o.pickupTime >= 0 && o.pickupTime < 1440 && o.pickupTime % 15 == 0
        && text(o.name, 1, 80)
        && text(o.phone, 6, 30)
        && text(o.notes, 0, 500)
        && o.lang in ['fr', 'en', 'mg']
        && o.status == 'new'
        && o.createdAt == request.time;
    }

    match /orders/{id} {
      allow create: if validOrder(request.resource.data) && ordersOpen(request.resource.data.pickupDay);
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt', 'statusBy'])
        && request.resource.data.status in ['new', 'preparing', 'ready', 'collected', 'cancelled'];
      allow delete: if isOwner();
    }

    // ---------- café settings ----------
    function validSettings(d) {
      return d.keys().hasOnly(['capacity', 'ordersPaused', 'bookingsPaused', 'closedDays', 'notice', 'soldOut', 'alertTopic', 'updatedAt', 'updatedBy'])
        && d.get('capacity', 20) is int && d.get('capacity', 20) >= 1 && d.get('capacity', 20) <= 200
        && d.get('ordersPaused', false) is bool
        && d.get('bookingsPaused', false) is bool
        && d.get('closedDays', []) is list && d.get('closedDays', []).size() <= 100
        && text(d.get('notice', ''), 0, 200)
        && d.get('soldOut', {}) is map && d.get('soldOut', {}).size() <= 300
        && text(d.get('alertTopic', ''), 0, 64);
    }
    match /settings/{name} {
      allow read: if true;
      allow write: if isStaff() && name == 'main' && validSettings(request.resource.data);
    }

    // ---------- staff list (document id = the staff member's email, lower case) ----------
    match /staff/{email} {
      allow read: if isStaff();
      allow create, update: if isOwner() && email == email.lower()
        && request.resource.data.keys().hasOnly(['addedAt', 'addedBy', 'name']);
      allow delete: if isOwner();
    }
  }
}
